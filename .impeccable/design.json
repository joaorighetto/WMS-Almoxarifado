      "css": ".ds-tile{display:block;margin:0;padding:12px 14px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);font-family:var(--font-family-base);line-height:var(--line-height-base);color:var(--color-text)}.ds-tile dt{color:var(--color-text-muted);font-size:.82rem}.ds-tile dd{margin:0;font-family:var(--font-family-mono);font-size:var(--font-size-metric);font-weight:650;line-height:var(--line-height-tight);font-variant-numeric:tabular-nums;overflow-wrap:break-word}"
