      "css": ".ds-badge{display:inline-flex;align-items:center;gap:5px;padding:1px 8px;background:var(--color-warning-surface);border-radius:var(--radius-badge);color:var(--color-text);font-family:var(--font-family-base);font-size:var(--font-size-badge);font-weight:600;line-height:var(--line-height-base);white-space:nowrap}.ds-badge::before{content:\"\";width:7px;height:7px;flex:none;background:var(--color-warning);border-radius:1px;transform:rotate(45deg)}"
    },
    {
      "name": "Painel de tarefas",
      "kind": "card",
      "refersTo": "card",
      "description": "Agrupamento plano com título e destino real.",
      "html": "<section class=\"ds-card\"><h2>Catálogo</h2><a href=\"#materiais\">Consultar materiais</a><p>Busque por código ou descrição e confira o saldo.</p></section>",
      "css": ".ds-card{padding:14px 16px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);color:var(--color-text);font-family:var(--font-family-base);font-size:var(--font-size-body);line-height:var(--line-height-base)}.ds-card h2{margin:0 0 .7rem;font-size:var(--font-size-section-title);font-weight:650}.ds-card a{color:var(--color-primary);text-decoration:none}.ds-card a:hover{text-decoration:underline}.ds-card a:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px;border-radius:var(--radius-focus)}.ds-card p{margin:0;color:var(--color-text-muted);font-size:var(--font-size-meta)}"
