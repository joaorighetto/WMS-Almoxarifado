      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:var(--control-height);padding:var(--control-pad-y) var(--control-pad-x);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text);font-family:var(--font-family-base);font-size:var(--font-size-body);line-height:var(--line-height-base);cursor:pointer;background:var(--color-primary);border-color:var(--color-primary);color:var(--color-surface);font-weight:600}.ds-primary:hover:not(:disabled){background:var(--color-primary-hover);border-color:var(--color-primary-hover)}.ds-primary:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px;border-radius:var(--radius-focus)}.ds-primary:disabled{background:var(--color-surface-subtle);border-color:var(--color-border);color:var(--color-text-muted);font-weight:400;cursor:not-allowed}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Controle compacto; altura cresce com o token responsivo.",
      "html": "<button type=\"button\" class=\"ds-secondary\">Limpar</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:var(--control-height);padding:var(--control-pad-y) var(--control-pad-x);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text);font-family:var(--font-family-base);font-size:var(--font-size-body);line-height:var(--line-height-base);cursor:pointer;}.ds-secondary:hover:not(:disabled){background:var(--color-surface-subtle)}.ds-secondary:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px;border-radius:var(--radius-focus)}.ds-secondary:disabled{background:var(--color-surface-subtle);border-color:var(--color-border);color:var(--color-text-muted);font-weight:400;cursor:not-allowed}"
    },
    {
      "name": "Botão destrutivo",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Preenchido de perigo só na confirmação de operação irreversível (estorno de entrada), no lugar do primário e recitando a consequência; o convite é secundário com borda de perigo. Altura cresce com o token responsivo.",
      "html": "<button type=\"button\" class=\"ds-danger\">Estornar entrada #12: 3 itens</button>",
      "css": ".ds-danger{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:var(--control-height);padding:var(--control-pad-y) var(--control-pad-x);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text);font-family:var(--font-family-base);font-size:var(--font-size-body);line-height:var(--line-height-base);cursor:pointer;background:var(--color-danger);border-color:var(--color-danger);color:#fff;font-weight:600}.ds-danger:hover:not(:disabled){background:var(--color-danger-hover);border-color:var(--color-danger-hover)}.ds-danger:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px;border-radius:var(--radius-focus)}.ds-danger:disabled{background:var(--color-surface-subtle);border-color:var(--color-border);color:var(--color-text-muted);font-weight:400;cursor:not-allowed}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Label visível, dica associada e tamanho responsivo; caixa avulsa com o rótulo inteiro como alvo e aviso de atenção vivo fora do aria-describedby.",
      "html": "<label class=\"ds-field\" for=\"ds-cadpro\">Código (CADPRO)<input id=\"ds-cadpro\" aria-describedby=\"ds-hint\" value=\"001.002.003\"><span id=\"ds-hint\" class=\"ds-hint\">Código inteiro, como no SCPI.</span></label><div class=\"ds-field\"><label for=\"ds-senha\">Senha</label><input id=\"ds-senha\" type=\"password\" value=\"segredo\"><p class=\"ds-hint-atencao\" aria-live=\"polite\">Caps Lock está ativado.</p><label class=\"ds-check\"><input type=\"checkbox\"> Mostrar senha</label></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:3px;font-family:var(--font-family-base);font-size:var(--font-size-label);color:var(--color-text-muted);line-height:var(--line-height-base)}.ds-field input{width:100%;min-height:var(--control-height);padding:var(--control-pad-y) var(--control-pad-x);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text);font-family:var(--font-family-mono);font-size:var(--font-size-input)}.ds-field input:focus-visible{outline:2px solid var(--color-focus);outline-offset:2px;border-radius:var(--radius-focus)}.ds-hint{font-size:var(--font-size-meta)}.ds-field input[type=password]{width:100%;min-height:var(--control-height);padding:var(--control-pad-y) var(--control-pad-x);background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-sm);color:var(--color-text);font-size:var(--font-size-input)}.ds-hint-atencao{position:relative;margin:0;padding-left:14px;font-size:var(--font-size-meta);color:var(--color-text)}.ds-hint-atencao::before{content:\"\";position:absolute;left:0;top:.45em;width:7px;height:7px;background:var(--color-warning);border-radius:1px;transform:rotate(45deg)}.ds-hint-atencao:empty{height:0;margin-top:-3px;padding:0;overflow:hidden}.ds-hint-atencao:empty::before{content:none}.ds-check{display:inline-flex;align-items:center;gap:var(--space-2);width:fit-content;min-height:var(--control-height);cursor:pointer}.ds-check input{flex-shrink:0;width:18px;height:18px;margin:0;accent-color:var(--color-primary)}"
    },
    {
