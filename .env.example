DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=

# Login simulado por papel, só em development com DEBUG (docs/development/login-simulado.md).
# Troque a identidade com ?dev_como=<papel> em qualquer URL.
WMS_LOGIN_SIMULADO=True
WMS_LOGIN_SIMULADO_PADRAO=chefe-almoxarifado

# Senha das contas criadas por seed_dev. Defina localmente antes de make setup.
# Use pelo menos 8 caracteres; evite senhas comuns ou somente numéricas.
SEED_DEV_PASSWORD=

DATABASE_NAME=wms_almoxarifado
DATABASE_USER=wms_almoxarifado
DATABASE_PASSWORD=wms_almoxarifado
DATABASE_HOST=localhost
DATABASE_PORT=5432
